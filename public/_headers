# El HTML y el registro del service worker siempre deben revalidarse. Si el CDN
# conserva index.html o sw.js, el navegador puede seguir apuntando a bundles de
# una versión anterior aunque los assets tengan hash.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, max-age=0, must-revalidate

/*/index.html
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Netlify-CDN-Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
  Netlify-CDN-Cache-Control: no-cache, no-store, must-revalidate

# Archivos con hash en el nombre (assets/…): nunca cambian, se cachean un año.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes de las landings (public/fonts): el nombre lleva la versión (-v1), así que
# un archivo nuevo es un nombre nuevo y el actual nunca cambia.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes sociales e íconos de la raíz: un día.
/*.png
  Cache-Control: public, max-age=86400

# Seguridad básica para todo el sitio.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
